# ══════════════════════════════════════════════════════════════════
# Docker build context exclusions
# Keep this tight for fast builds and small images
# ══════════════════════════════════════════════════════════════════

# Dependencies (rebuilt in container)
node_modules
.npm

# Build output (rebuilt in container)
dist

# Version control
.git
.gitignore
.gitattributes

# Environment & secrets
.env
.env.local
.env.*.local

# IDE & editors
.vscode
.idea
*.swp
*.swo
*~
.project
.settings

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test & coverage
coverage
.nyc_output
*.test.ts
*.spec.ts
__tests__
vitest.config.*

# Documentation (not needed in image)
docs
*.md
!package.json

# Docker files (avoid recursive copy)
Dockerfile
docker-compose*.yml
.dockerignore

# Kiro & tooling config
.kiro
.prettierrc
.prettierignore
eslint.config.js
components.json
info.md

# Temporary & cache
tmp
.cache
.turbo
