# ── Auth ────────────────────────────────────────────────────────
JWT_SECRET=               # Secret key for signing session JWTs (any long random string)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Admin (optional) ───────────────────────────────────────────
ADMIN_EMAIL=              # Email that gets admin role on registration (optional)
