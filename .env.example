# ══════════════════════════════════════════════════════════════════
# SaanjhCyber — Environment Configuration
# Copy this file to .env and fill in the values
# ══════════════════════════════════════════════════════════════════

# ── Auth ────────────────────────────────────────────────────────
JWT_SECRET=               # Secret key for signing session JWTs (any long random string)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)
MYSQL_ROOT_PASSWORD=      # MySQL root password (required for Docker)
MYSQL_USER=saanjh         # MySQL application user
MYSQL_PASSWORD=saanjh     # MySQL application user password
MYSQL_DATABASE=saanjhcyber # MySQL database name

# ── Admin (optional) ───────────────────────────────────────────
ADMIN_EMAIL=              # Email that gets admin role on registration

# ── Ports (optional, for Docker) ───────────────────────────────
APP_PORT=3000             # Host port for the application
DB_PORT=3306              # Host port for MySQL
